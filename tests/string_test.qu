load "std::io";
load "std::string";

using std::string;

// expect - report a failed expectation.
bool expect(bool cond, str what) {
    if (cond)
        return true;
    std::io::print("BAD ");
    std::io::print(what);
    std::io::print("\n");
    return false;
}

i32 main() {
    str s = "hello";

    if (!expect(str_len(s) == 5, "len"))
        return 1;
    if (!expect(str_eq(s, "hello"), "eq"))
        return 1;
    if (!expect(!str_eq(s, "world"), "neq"))
        return 1;

    // str is *char, so the bytes are reachable by indexing
    if (!expect(s[0] == (104 as char), "index"))
        return 1;

    // string_make copies into a heap allocation
    mut string a = string_make(s);
    if (!expect(a.len() == 5, "copy len"))
        return 1;
    if (!expect(a.data != s, "alias"))
        return 1;
    if (!expect(a.data[5] == 0, "term"))
        return 1;
    if (!expect(a.eq("hello"), "copy eq"))
        return 1;

    // push and push_str grow the buffer past the initial capacity
    a.push_str(" world");
    a.push(33 as char);
    if (!expect(a.len() == 12, "push len"))
        return 1;
    if (!expect(a.eq("hello world!"), "push eq"))
        return 1;
    if (!expect(a.data[12] == 0, "push term"))
        return 1;
    if (!expect(a.get(6) == (119 as char), "get"))
        return 1;

    // sub clamps the count and yields an empty string for a late start
    string part = a.sub(6, 5);
    if (!expect(part.eq("world"), "sub"))
        return 1;
    string rest = a.sub(6, 100);
    if (!expect(rest.len() == 6, "sub clamp"))
        return 1;
    string none = a.sub(99, 1);
    if (!expect(none.is_empty(), "sub range"))
        return 1;

    // concat builds a new string and leaves the receiver alone
    string cat = a.concat("?");
    if (!expect(cat.eq("hello world!?"), "concat"))
        return 1;
    if (!expect(a.len() == 12, "concat src"))
        return 1;

    // an empty string owns no memory
    string empty = string_make("");
    if (!expect(empty.is_empty(), "empty"))
        return 1;
    if (!expect(empty.len() == 0, "empty len"))
        return 1;

    empty.free();
    none.free();
    rest.free();
    cat.free();
    part.free();
    a.free();

    // free resets the string, so it can be filled again
    a.push(65 as char);
    if (!expect(a.eq("A"), "reuse"))
        return 1;
    a.free();
    if (!expect(a.len() == 0, "free len"))
        return 1;

    std::io::print("string OK\n");
    return 0;
}