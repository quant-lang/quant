load "std::io";
using std::io;

mut i32 g_counter = 0;

void tick() { g_counter = g_counter + 1; }

i32 main() {
    // plain while with continue (continue re-checks the condition directly)
    mut i32 i = 0;
    mut i32 s = 0;
    while (i < 6) {
        if (i == 2) { i = i + 1; continue; }
        s = s + i;
        i = i + 1;
    }
    println(s as str);              // 0+1+3+4+5 = 13

    // global modified inside the loop: must run at runtime
    for (mut i32 k = 0; k < 7; k = k + 1) { tick(); }
    println(g_counter as str);      // 7

    // global read inside a loop bound
    mut i32 t = 0;
    for (mut i32 m = 0; m < g_counter; m = m + 1) { t = t + 2; }
    println(t as str);              // 14

    // i64 wrap-around in a folded loop
    mut i64 w = 9223372036854775800;
    for (mut i32 n = 0; n < 16; n = n + 1) { w = w + 1; }
    println(w as str);              // wraps to -9223372036854775800

    // switch with break inside a loop
    mut i32 acc = 0;
    for (mut i32 q = 0; q < 10; q = q + 1) {
        switch (q) {
            case 3: { acc = acc + 100; }
            case 8: { break; }
            default: { acc = acc + 1; }
        }
        acc = acc + 10;
    }
    println(acc as str);            // 8 defaults + 100 + 10*10 = 208

    // @init variable written in a loop before being read
    @init mut i32 late;
    for (mut i32 z = 0; z < 3; z = z + 1) {
        late = z * 10;
    }
    println(late as str);           // 20

    // bool accumulation
    mut bool any = false;
    for (mut i32 b = 0; b < 5; b = b + 1) {
        any = any || (b == 4);
    }
    if (any) { println("yes"); } else { println("no"); }

    // nested loop with break from the inner loop only
    mut i32 pairs = 0;
    for (mut i32 x = 0; x < 5; x = x + 1) {
        for (mut i32 y = 0; y < 5; y = y + 1) {
            if (y > x) { break; }
            pairs = pairs + 1;
        }
    }
    println(pairs as str);          // 15

    // mixed signed / unsigned compare through promotion
    mut i32 neg = -1;
    mut u32 u = 5;
    if (neg < u) { println("lt"); } else { println("ge"); }

    // char arithmetic
    mut u8 ch = 97;
    mut i32 letters = 0;
    while (ch <= 122) {
        letters = letters + 1;
        ch = ch + 1;
    }
    println(letters as str);        // 26
    return 0;
}
