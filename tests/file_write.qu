load "std::io";

i32 main() {
    // "r"  - open existing file for reading
    // "w"  - open for writing, create or truncate the file
    // "a"  - open for appending, create if it does not exist
    // "r+" - open existing file for reading and writing
    // "w+" - open for reading and writing, create or truncate the file
    // "a+" - open for reading and appending, create if it does not exist
    mut i64 fd = std::io::open("test_output.txt", "w");

    if (fd < 0) {
        std::io::println("open failed");
        return 1;
    }

    std::io::print("opened fd=");
    std::io::print(fd as str);
    std::io::print_char('\n');

    mut i64 written = std::io::write(fd, "Hello from Quant!\n", 18);

    std::io::print("wrote ");
    std::io::print(written as str);
    std::io::print(" bytes\n");

    std::io::close(fd);

    std::io::println("done");
    return 0;
}