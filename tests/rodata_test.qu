load "std::io";

@init mut i64 g_counter;

i32 main() {
    mut str a = "alpha";
    mut str b = "beta";
    g_counter = 41;

    region r {
        str buf = alloc(char, 16);
        mut i32 i = 0;
        while (i < 16) {
            buf[i] = 'A';
            i++;
        }
        std::io::print_char(buf[0]);
        std::io::print_char(buf[15]);
    }

    std::io::println(a);
    std::io::println(b);
    std::io::println((g_counter + 1) as str);
    return 0;
}
