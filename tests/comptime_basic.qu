load "std::io";
using std::io;

// Bools cannot be cast to str/i32 in Quant, so print them via this helper.
i32 b2i(bool b) {
    if (b) {
        return 1;
    }
    return 0;
}

i32 comptime_id(i32 x) {
    return x;
}

i64 comptime_mul(i32 a, i32 b) {
    return (a * b) as i64;
}

bool comptime_lt(i32 a, i32 b) {
    if (a < b) {
        return true;
    }
    return false;
}

i32 main() {
    // '#' forces evaluation at compile time regardless of the optimization level.
    mut i32 a = #(2 + 3 * 4);
    println(a as str);                      // 14

    // Unary minus and logic negation.
    mut i32 b = #(-(5));
    println(b as str);                      // -5
    mut i32 c = b2i(#(!false));
    println(c as str);                      // 1

    // Comparison results are bool.
    mut i32 d = b2i(#(10 > 3));
    println(d as str);                      // 1
    mut i32 e = b2i(#(10 <= 3));
    println(e as str);                      // 0
    mut i32 f = b2i(#(4 == 4));
    println(f as str);                      // 1
    mut i32 g = b2i(#(4 != 4));
    println(g as str);                      // 0

    // Logical operators with short-circuit semantics.
    mut i32 h = b2i(#(true && false));
    println(h as str);                      // 0
    mut i32 i = b2i(#(false || true));
    println(i as str);                      // 1

    // Compile-time bool in a runtime 'if'.
    if (#(5 > 2)) {
        println("bigger");                   // bigger
    } else {
        println("smaller");
    }

    // Calls to user functions are evaluated at compile time.
    mut i32 j = #comptime_id(42);
    println(j as str);                      // 42
    mut i64 k = #comptime_mul(6, 7);
    println(k as str);                      // 42

    // A call returning a bool.
    mut i32 l = b2i(#comptime_lt(1, 2));
    println(l as str);                      // 1

    // sizeof at compile time.
    mut u64 m = #sizeof(i32);
    println(m as str);                      // 4

    return 0;
}