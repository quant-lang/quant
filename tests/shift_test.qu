load "std::io";
using std::io;

// Shift operators: precedence, associativity, signed/unsigned right shift,
// literal adaptation and enum operands.
enum Flags {
    None,
    First,
    Second,
};

i32 main() {
    // Basic shifts.
    println((1 << 4) as str);                          // 16
    println((256 >> 4) as str);                        // 16

    // Signed right shift is arithmetic.
    println((-16 >> 2) as str);                        // -4

    // Unsigned right shift is logical, including values above INT64_MAX.
    u64 big = 0x8000_0000_0000_0000;
    println((big >> 60) as str);                       // 8

    // The shift amount can come from a variable.
    i32 amount = 3;
    i32 value = 5;
    println((value << amount) as str);                 // 40
    println((value >> amount) as str);                 // 0

    // Precedence: '+' binds tighter than '<<', which binds tighter than '&'.
    println((1 << 2 + 1) as str);                      // 1 << 3 = 8
    println((1 + 2 << 3) as str);                      // 3 << 3 = 24
    println((3 << 2 & 12) as str);                     // (3 << 2) & 12 = 12

    // Shifts are left-associative.
    println((1 << 2 << 3) as str);                     // (1 << 2) << 3 = 32
    println((64 >> 2 >> 1) as str);                    // 8

    // Unsuffixed literals adapt to the other operand's type.
    u64 one = 1;
    println((one << 63) as str);                       // 9223372036854775808
    u8 byte = 1u8;
    println((byte << 2) as str);                       // 4

    // Right shift of a signed value keeps the sign; unsigned does not.
    i64 minus_one = -1;
    println((minus_one >> 63) as str);                 // -1
    u64 umax = 0xFFFF_FFFF_FFFF_FFFFu64;
    println((umax >> 63) as str);                      // 1

    // Enums participate in shifts as their underlying i32 value.
    i32 flag_shift = Flags::Second << 2;               // 2 << 2 = 8
    println(flag_shift as str);                        // 8

    return 0;
}
