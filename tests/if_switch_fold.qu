load "std::io";
using std::io;

// Runtime value: the branch below must NOT fold, and must still be correct.
i32 pick(i32 v) {
    mut i32 r = 0;
    if (v > 0) {
        r = 1;
    } else {
        r = 2;
    }
    return r;
}

i32 main() {
    // if with a constant true condition → taken branch
    mut i32 a = 0;
    if (3 < 5) {
        a = 11;
    } else {
        a = 22;
    }
    println(a as str);          // 11

    // if with a constant false condition → else branch
    mut i32 b = 0;
    if (b == 1) {
        b = 33;
    } else {
        b = 44;
    }
    println(b as str);          // 44

    // plain if (no else) with a constant condition
    mut i32 c = 7;
    if (c > 5) {
        c = c + 1;
    }
    println(c as str);          // 8

    // else-if chain: middle branch taken
    mut i32 d = 0;
    if (d == 5) {
        d = 1;
    } else if (d == 0) {
        d = 2;
    } else {
        d = 3;
    }
    println(d as str);          // 2

    // else-if chain: final (default) branch taken
    mut i32 e = 9;
    if (e == 1) {
        e = 1;
    } else if (e == 2) {
        e = 2;
    } else if (e == 3) {
        e = 3;
    } else {
        e = 4;
    }
    println(e as str);          // 4

    // switch: matching case selected
    mut i32 f = 2;
    switch (f) {
        case 1: { f = 10; }
        case 2: { f = 20; }
        case 3: { f = 30; }
        default: { f = 40; }
    }
    println(f as str);          // 20

    // switch: default selected
    mut i32 g = 5;
    switch (g) {
        case 1: { g = 100; }
        case 7: { g = 700; }
        default: { g = 900; }
    }
    println(g as str);          // 900

    // switch: nothing matches and no default → unchanged
    mut i32 h = 5;
    switch (h) {
        case 1: { h = 100; }
        case 2: { h = 200; }
    }
    println(h as str);          // 5

    // runtime condition → not folded, still correct
    mut i32 r1 = pick(7);
    println(r1 as str);         // 1
    mut i32 r2 = pick(-3);
    println(r2 as str);         // 2

    // if inside a loop → nothing folded, still correct
    mut i32 acc = 0;
    for (mut i32 k = 0; k < 4; k = k + 1) {
        if (1 < 2) {
            acc = acc + k;
        }
        acc = acc + 1;
    }
    println(acc as str);        // 10

    return 0;
}