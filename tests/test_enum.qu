load "std::io";

@public
enum Status {
    Ok,
    Error,
    Unknown,
};

void main() {
    i32 s1 = Status::Ok;
    i32 s2 = Status::Error;
    i32 s3 = Status::Unknown;

    std::io::print(s1 as str);
    std::io::print(" ");
    std::io::print(s2 as str);
    std::io::print(" ");
    std::io::print(s3 as str);
    std::io::print("\n");
}
