// std::io
//
// Input/output functions. Pure Quant implementation using inline syscalls.
//
// Usage:
//   load "std::io";
//
//   i32 main() {
//       std::io::print("hello ");
//       std::io::println("world");
//       std::io::print_char('A');
//
//       i64 fd = std::io::open("test.txt", 65, 438);
//       std::io::write(fd, "hello", 5);
//       std::io::close(fd);
//
//       std::io::exit(0);
//       return 0;
//   }

module "std::io";

// Linux syscall numbers:
//   read = 0, write = 1, close = 3, lseek = 8, exit = 60,
//   fsync = 74, openat = 257 (AT_FDCWD = -100)

@syscall(0) extern i64 sys_read(i64 fd, str buf, i64 len);
@syscall(1) extern i64 sys_write(i64 fd, str buf, i64 len);
@syscall(3) extern i64 sys_close(i64 fd);
@syscall(8) extern i64 sys_lseek(i64 fd, i64 offset, i64 whence);
@syscall(60) extern void sys_exit(i64 code);
@syscall(74) extern i64 sys_fsync(i64 fd);
@syscall(257) extern i64 sys_openat(i64 dirfd, str path, i64 flags, i64 mode);

// strlen - number of bytes in a NUL-terminated string, without the \0.
i64 strlen(str s) {
    mut i64 i = 0;
    while (s[i] != 0) {
        i++;
    }
    return i;
}

// print - print a string to stdout.
void print(str text) {
    sys_write(1, text, strlen(text));
}

// println - print a string followed by a newline to stdout.
void println(str text) {
    print(text);
    print_char('\n');
}

// eprint - print a string to stderr.
void eprint(str text) {
    sys_write(2, text, strlen(text));
}

// ByteBuf - single-byte buffer for the read/write syscalls.
// `&` needs a non-scalar, so a bare `char` variable cannot be passed to them.
struct ByteBuf { char c; };
@init mut ByteBuf g_byte_buf;

// print_char - print a single byte to stdout.
void print_char(char c) {
    g_byte_buf.c = c;
    sys_write(1, (&g_byte_buf) as! str, 1);
}

// exit - terminate the program with the given exit code.
void exit(i32 code) {
    sys_exit(code);
}

// open - open a file and return its fd.
// flags: 65 = O_RDWR|O_CREAT, mode: 438 = 0666.
i64 open(str path, i32 flags, i32 mode) {
    i64 r = sys_openat(-100, path, flags, mode);
    if (r < 0) { return -r; }
    return r;
}

// close - close a file descriptor.
i64 close(i64 fd) {
    i64 r = sys_close(fd);
    if (r < 0) { return -r; }
    return r;
}

// seek - reposition the file offset of a descriptor.
i64 seek(i64 fd, i64 offset, i32 whence) {
    i64 r = sys_lseek(fd, offset, whence);
    if (r < 0) { return -r; }
    return r;
}

// flush - flush file buffers to disk.
i64 flush(i64 fd) {
    i64 r = sys_fsync(fd);
    if (r < 0) { return -r; }
    return r;
}

// write - write `len` bytes to a descriptor. Returns bytes written.
i64 write(i64 fd, str buf, i64 len) {
    i64 r = sys_write(fd, buf, len);
    if (r < 0) { return -r; }
    return r;
}

// read_fd - read up to `len` bytes from a descriptor.
i64 read_fd(i64 fd, str buf, i64 len) {
    i64 r = sys_read(fd, buf, len);
    if (r < 0) { return -r; }
    return r;
}

// read - read up to `len` bytes from stdin.
i64 read(str buf, i64 len) {
    i64 r = sys_read(0, buf, len);
    if (r < 0) { return -r; }
    return r;
}

// read_char - read a single byte from stdin, or -1 at end of input.
i64 read_char() {
    i64 n = sys_read(0, (&g_byte_buf) as! str, 1);
    if (n <= 0) { return -1; }
    return g_byte_buf.c as i64;
}
