// std::string
//
// String helpers and the owning `string` type.
// `str` is an alias for `*char`, so aи `str` parameter is a bare pointer to
// NUL-terminated bytes and a string literal can be passed directly, without
// a cast.
//
// `string` owns its bytes on the heap (std::heap) and always keeps a
// terminating \0, so cstr() can be handed to any `str` parameter.
//
// Usage:
//   load "std::string";
//   using std::string;
//
//   void main() {
//       mut string s = string_make("hello");
//       s.push_str(" world");
//       s.push(33 as char);
//       std::io::print(s.cstr());       // hello world!
//       std::io::print(s.len() as str);  // 12
//
//       string part = s.sub(6, 5);      // world
//       string all = s.concat("?");      // hello world!?
//       part.free();
//       all.free();
//       s.free();
//   }
//
// Notes:
//   - string_make copies; the source can be a literal or any NUL-terminated
//     buffer.
//   - get and len are unchecked.
//   - free must be called to release memory.

module "std::string";

load "std::heap";

struct string {
    mut *char data;
    mut u64 len;
    mut u64 cap;

    // len - number of bytes, without the terminating \0.
    u64 len() {
        return len;
    }

    // is_empty - true if the string holds no bytes.
    bool is_empty() {
        return len == 0;
    }

    // cstr - the contents as a NUL-terminated string (borrow, no copy).
    // Valid until the string is mutated or freed.
    str cstr() {
        return data;
    }

    // get - the byte at `index` (unchecked).
    char get(u64 index) {
        return data[index];
    }

    // eq - compare the contents with `other`.
    bool eq(str other) {
        return str_eq(data, other);
    }

    // reserve - make room for `need` bytes plus the terminator.
    // Returns false when the allocation fails, leaving the string unchanged.
    bool reserve(u64 need) {
        if (cap >= need + 1)
            return true;
        mut u64 ncap = cap;
        if (ncap == 0)
            ncap = 16;
        while (ncap < need + 1)
            ncap *= 2;
        *void p = std::heap::heap_realloc(data as! *void, ncap);
        if (p == (0 as! *void))
            return false;
        data = p as! *char;
        cap = ncap;
        return true;
    }

    // push - append a byte. The string is unchanged if the allocation fails.
    void push(char c) {
        if (!reserve(len + 1))
            return;
        data[len] = c;
        len++;
        data[len] = 0;
    }

    // push_str - append a NUL-terminated string.
    // The string is unchanged if the allocation fails.
    void push_str(str s) {
        u64 n = str_len(s);
        if (!reserve(len + n))
            return;
        for (mut u64 i = 0; i < n; i++)
            data[len + i] = s[i];
        len += n;
        data[len] = 0;
    }

    // sub - a new string with bytes [start, start + count).
    // An out-of-range start yields an empty string; count is clamped to the
    // remaining bytes.
    string sub(u64 start, mut u64 count) {
        if (start >= len)
            return string_empty();
        u64 avail = len - start;
        if (count > avail)
            count = avail;
        // @init does not zero memory, so every field is set before reserve.
        mut string part = string_empty();
        if (!part.reserve(count))
            return part;
        for (mut u64 i = 0; i < count; i++)
            part.data[i] = data[start + i];
        part.len = count;
        part.data[count] = 0;
        return part;
    }

    // concat - a new string holding the contents followed by `other`.
    string concat(str other) {
        mut string res = string_empty();
        if (!res.reserve(len + str_len(other)))
            return res;
        for (mut u64 i = 0; i < len; i++)
            res.data[i] = data[i];
        res.len = len;
        res.push_str(other);
        return res;
    }

    // free - release the backing allocation. free() on an empty string is a
    // no-op.
    void free() {
        if (cap > 0)
            std::heap::heap_free(data as! *void);
        data = 0 as! *char;
        len = 0;
        cap = 0;
    }
};

// str_len - number of bytes in a NUL-terminated string, without the \0.
u64 str_len(str s) {
    mut u64 i = 0;
    while (s[i] != 0)
        i++;
    return i;
}

// str_eq - compare the contents of two NUL-terminated strings.
bool str_eq(str a, str b) {
    mut u64 i = 0;
    while (true) {
        char ca = a[i];
        char cb = b[i];
        if (ca != cb)
            return false;
        if (ca == 0)
            return true;
        i++;
    }
    // unreachable: the loop above only leaves through a return
    return false;
}

// string_empty - an empty string that owns no memory.
string string_empty() {
    @init mut string s;
    s.data = 0 as! *char;
    s.len = 0;
    s.cap = 0;
    return s;
}

// string_make - copy `src` into a fresh heap allocation.
// Returns an empty string when the allocation fails.
string string_make(str src) {
    mut string s = string_empty();
    u64 n = str_len(src);
    if (!s.reserve(n))
        return s;
    for (mut u64 i = 0; i < n; i++)
        s.data[i] = src[i];
    s.len = n;
    s.data[n] = 0;
    return s;
}
