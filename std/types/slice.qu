// std::types - slice<T>
//
// A slice is a non-owning view into contiguous memory.
// It contains only a pointer and a length, making it a cheap way
// to pass around arrays, region allocations, vectors, or parts of them.
//
// Usage:
//   load "std::types";
//   using std::types;
//
//   void main() {
//       region r {
//           *i32 buf = alloc(i32, 10);
//           slice<i32> s = slice_make<i32>(buf, 10);
//           s.set(0, 42);
//           std::io::print(s.get(0) as str);  // 42
//       }
//   }
//
// Notes:
//   - get and set are unchecked.
//   - Use at for checked access.
//   - A slice must not outlive the memory it points to.

module "std::types";

struct slice<T> {
    mut *T data;
    mut u64 len;

    // len - number of elements in the slice.
    u64 len() {
        return len;
    }

    // is_empty - true if the slice has no elements.
    bool is_empty() {
        return len == 0;
    }

    // ptr - the raw backing pointer.
    *T ptr() {
        return data;
    }

    // in_bounds - true if `i` is a valid index.
    bool in_bounds(u64 i) {
        return i < len;
    }

    // get - read element at `i` (unchecked).
    T get(u64 i) {
        return data[i];
    }

    // set - write element at `i` (unchecked).
    void set(u64 i, T val) {
        data[i] = val;
    }

    // at - read element at `i`, returning option<T>.
    // Returns option_none<T>() when the index is out of bounds.
    option<T> at(u64 i) {
        if (i < len) { return option_some<T>(data[i]); }
        return option_none<T>();
    }

    // sub - a view of elements [start, start + len).
    // Out-of-range starts yield an empty slice; len is clamped to
    // the remaining elements.
    slice<T> sub(u64 start, mut u64 count) {
        if (start >= len) { return slice_empty<T>(); }
        u64 avail = len - start;
        if (count > avail) { count = avail; }
        *T p = ((data as! u64) + start * sizeof(T)) as! *T;
        @init mut slice<T> sub;
        sub.data = p;
        sub.len = count;
        return sub;
    }

    // copy_from - copy up to this.len elements from `src` into this.
    // Copies min(dst.len, src.len) elements.
    void copy_from(&slice<T> src) {
        mut u64 n = src.len;
        if (len < n) { n = len; }
        for (mut u64 i = 0; i < n; i++) {
            data[i] = src.data[i];
        }
    }
};

// slice_make - build a slice from a pointer and a length.
slice<T> slice_make<T>(*T data, u64 len) {
    @init mut slice<T> s;
    s.data = data;
    s.len = len;
    return s;
}

// slice_empty - an empty slice (length 0, no backing buffer).
slice<T> slice_empty<T>() {
    @init mut slice<T> s;
    s.data = 0 as! *T;
    s.len = 0;
    return s;
}

// --- Deprecated free-function wrappers. Prefer the slice<T> methods. ---

// slice_len - number of elements in the slice.
u64 slice_len<T>(&slice<T> s) {
    return s.len();
}

// slice_is_empty - true if the slice has no elements.
bool slice_is_empty<T>(&slice<T> s) {
    return s.is_empty();
}

// slice_ptr - the raw backing pointer.
*T slice_ptr<T>(&slice<T> s) {
    return s.ptr();
}

// slice_in_bounds - true if `i` is a valid index.
bool slice_in_bounds<T>(&slice<T> s, u64 i) {
    return s.in_bounds(i);
}

// slice_get - read element at `i` (unchecked).
T slice_get<T>(&slice<T> s, u64 i) {
    return s.get(i);
}

// slice_set - write element at `i` (unchecked).
void slice_set<T>(mut &slice<T> s, u64 i, T val) {
    s.set(i, val);
}

// slice_at - read element at `i`, returning option<T>.
// Returns option_none<T>() when the index is out of bounds.
option<T> slice_at<T>(&slice<T> s, u64 i) {
    return s.at(i);
}

// slice_sub - a view of elements [start, start + len).
// Out-of-range starts yield an empty slice; len is clamped to
// the remaining elements.
slice<T> slice_sub<T>(&slice<T> s, u64 start, mut u64 len) {
    return s.sub(start, len);
}

// slice_copy - copy up to dst.len elements from src into dst.
// Copies min(dst.len, src.len) elements.
void slice_copy<T>(mut &slice<T> dst, &slice<T> src) {
    dst.copy_from(src);
}
