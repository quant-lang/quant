// std::vector
//
// Generic growable array backed by heap allocation.
//
// Usage:
//   load "std::vector";
//   using std::vector;
//
//   void main() {
//       @init mut vec<i32> v;
//       v.push(10);
//       v.push(20);
//       v.push(30);
//       std::io::print(v.get(1) as str);  // 20
//       v.free();
//   }
//
// Notes:
//   - free must be called to release memory.
//   - get bounds are not checked.
//   - try_get is bounds-checked and returns option<T>.

module "std::vector";

load "std::heap";
load "std::types";

struct vec<T> {
    mut *T data;
    mut i32 size = 0;
    mut i32 capacity = 0;

    // push - append `val` to the end of the vector.
    void push(T val) {
        u64 elem_size = sizeof(T);
        if (capacity == 0) {
            data = std::heap::heap_malloc(elem_size) as! *T;
            capacity = 1;
        } else if (size >= capacity) {
            capacity *= 2;
            data = std::heap::heap_realloc(data as! *void, capacity * elem_size) as! *T;
        }
        data[size] = val;
        size++;
    }

    // get - read the element at `index` (unchecked).
    T get(i32 index) {
        return data[index];
    }

    // try_get - read the element at `index`, or none when out of bounds.
    option<T> try_get(i32 index) {
        if (index >= 0 && index < size) {
            return option_some<T>(data[index]);
        }
        return option_none<T>();
    }

    // len - number of elements in the vector.
    u64 len() {
        return size as u64;
    }

    // free - release the backing allocation. free() on an empty vector
    // is a no-op.
    void free() {
        if (capacity > 0) {
            std::heap::heap_free(data as! *void);
            data = 0 as! *T;
            capacity = 0;
        }
    }
};
