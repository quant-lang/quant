// std::arena - Windows implementation for the native (PE) backend.
//
// Region (bump pointer) allocator built on VirtualAlloc/VirtualFree
// (kernel32.dll) instead of mmap/munmap.

module "std::arena";

@import("kernel32.dll", "VirtualAlloc") extern *void sys_virtual_alloc(*void lpAddress, u64 dwSize, u32 flAllocationType, u32 flProtect);
@import("kernel32.dll", "VirtualFree") extern i32 sys_virtual_free(*void lpAddress, u64 dwSize, u32 dwFreeType);

struct Region {
    *void data;
    u64 offset;
    u64 capacity;

    // bump - allocate `size` bytes from this region (16-byte aligned).
    // Returns NULL if the region has no space left.
    *void bump(u64 size) {
        mut u64 a = size + 15;
        a = a & ((-16 as i64) as u64);
        u64 off = offset;
        u64 end = off + a;
        if (end > capacity) { return 0 as! *void; }
        u64 res = (data as! u64) + off;
        offset = end;
        return res as! *void;
    }

    // destroy - release the backing memory of this region.
    void destroy() {
        _region_munmap(data, capacity);
        data = 0 as! *void;
        offset = 0;
        capacity = 0;
    }

    // buf - allocate a writable buffer of `size` bytes plus a NUL terminator.
    // The buffer is zero-filled, so it is always a valid `str` even when
    // nothing is read into it. Returns an empty string if the region is full,
    // so the result never needs a cast at the call site:
    //   mut str buf = r.buf(256);
    //   i64 n = std::io::read(buf, 256);
    str buf(u64 size) {
        if (size == 0) { return ""; }
        *u8 mem = bump(size + 1) as! *u8;
        if (mem == (0 as! *u8)) { return ""; }
        mut u64 i = 0;
        while (i <= size) {
            mem[i] = 0;
            i++;
        }
        return mem as! str;
    }
};

// _region_mmap - map `size` bytes of readable/writable memory.
*void _region_mmap(u64 size) {
    return sys_virtual_alloc(0 as! *void, size, 12288, 4);
}

// _region_munmap - release `size` bytes previously returned by _region_mmap.
void _region_munmap(*void ptr, u64 size) {
    if (ptr == (0 as! *void)) { return; }
    sys_virtual_free(ptr, 0, 32768);
}

// _create - create a new region backed by an allocated block of `size` bytes.
Region _create(u64 size) {
    mut Region r;
    r.data = _region_mmap(size);
    r.offset = 0;
    r.capacity = size;
    return r;
}

// Deprecated free-function wrappers. Prefer the Region methods.

// _region_bump - allocate `size` bytes from a region (16-byte aligned).
// Returns NULL if the region has no space left.
*void _region_bump(mut &Region reg, u64 size) {
    return reg.bump(size);
}

// _destroy - release the backing memory of a region.
void _destroy(mut &Region reg) {
    reg.destroy();
}
