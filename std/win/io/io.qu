// std::io - Windows implementation for the native (PE) backend.
//
// Uses @import (WinAPI) instead of Linux syscalls.
// str is a null-terminated char pointer (LPCSTR), so it maps
// directly onto the WinAPI buffer parameters.
//
// Usage:
//   load "std::io";
//
//   void main() {
//       std::io::print("hello ");
//       std::io::println("world");
//       std::io::print_char('A');
//       std::io::exit(0);
//   }

module "std::io";

@import("kernel32.dll", "GetStdHandle") extern i64 sys_get_std_handle(i64 nStdHandle);
@import("kernel32.dll", "WriteFile") extern i32 sys_write_file(i64 hFile, str lpBuffer, i64 nNumberOfBytesToWrite, str lpNumberOfBytesWritten, *void lpOverlapped);
@import("kernel32.dll", "ReadFile") extern i32 sys_read_file(i64 hFile, str lpBuffer, i64 nNumberOfBytesToRead, str lpNumberOfBytesRead, *void lpOverlapped);
@import("kernel32.dll", "ExitProcess") extern void sys_exit_process(u32 uExitCode);
@import("kernel32.dll", "CreateFileA") extern i64 sys_create_file(str lpFileName, u32 dwDesiredAccess, u32 dwShareMode, *void lpSecurityAttributes, u32 dwCreationDisposition, u32 dwFlagsAndAttributes, *void hTemplateFile);
@import("kernel32.dll", "CloseHandle") extern i32 sys_close_handle(i64 hObject);
@import("kernel32.dll", "SetFilePointerEx") extern i32 sys_set_file_pointer(i64 hFile, i64 liDistanceToMove, *void lpNewFilePointer, u32 dwMoveMethod);
@import("kernel32.dll", "FlushFileBuffers") extern i32 sys_flush_file_buffers(i64 hFile);

@init mut i64 g_stdout;
@init mut i64 g_stdin;
@init mut i64 g_stderr;

// Scratch location for the WinAPI "bytes transferred" out-parameter.
// The Quant `&` operator only works on non-scalars, so it's a struct.
struct IoScratch { i64 v; };
@init mut IoScratch g_scratch;

// qk_io_init - cache the standard handles. Called by the generated entry stub.
@export("qk_io_init") void qk_io_init() {
    g_stdout = sys_get_std_handle(-11);
    g_stdin = sys_get_std_handle(-10);
    g_stderr = sys_get_std_handle(-12);
}

// strlen - number of bytes in a NUL-terminated string, without the \0.
i64 strlen(str s) {
    mut i64 i = 0;
    while (s[i] != 0) {
        i++;
    }
    return i;
}

// print - print string to stdout.
void print(str text) {
    sys_write_file(g_stdout, text, strlen(text), (&g_scratch) as! str, 0 as! *void);
}

// println - print string + newline to stdout.
void println(str text) {
    print(text);
    print_char('\n');
}

// eprint - print string to stderr.
void eprint(str text) {
    sys_write_file(g_stderr, text, strlen(text), (&g_scratch) as! str, 0 as! *void);
}

// ByteBuf - single-byte buffer for the read/write calls.
// `&` needs a non-scalar, so a bare `char` variable cannot be passed to WinAPI.
struct ByteBuf { char c; };
@init mut ByteBuf g_byte_buf;

// print_char - print one byte to stdout.
void print_char(char c) {
    g_byte_buf.c = c;
    sys_write_file(g_stdout, (&g_byte_buf) as! str, 1, (&g_scratch) as! str, 0 as! *void);
}

// exit - exit program with the given code.
void exit(i32 code) {
    sys_exit_process(code as u32);
}

// write - write bytes to a handle. Returns bytes written.
i64 write(i64 fd, str buf, i64 len) {
    sys_write_file(fd, buf, len, (&g_scratch) as! str, 0 as! *void);
    return g_scratch.v;
}

// read_fd - read bytes from a handle. Returns bytes read.
i64 read_fd(i64 fd, str buf, i64 len) {
    sys_read_file(fd, buf, len, (&g_scratch) as! str, 0 as! *void);
    return g_scratch.v;
}

// read - read from stdin. Returns bytes read.
i64 read(str buf, i64 len) {
    sys_read_file(g_stdin, buf, len, (&g_scratch) as! str, 0 as! *void);
    return g_scratch.v;
}

// read_char - read one byte from stdin.
i64 read_char() {
    sys_read_file(g_stdin, (&g_byte_buf) as! str, 1, (&g_scratch) as! str, 0 as! *void);
    if (g_scratch.v <= 0) { return -1; }
    return g_byte_buf.c as i64;
}

struct FpScratch { i64 v; };
@init mut FpScratch g_fp;

// open - open/create a file. flags = dwDesiredAccess (e.g. GENERIC_WRITE = 0x40000000),
// mode = dwCreationDisposition (e.g. CREATE_ALWAYS = 2). Returns a handle, or < 0 on failure.
i64 open(str path, i32 flags, i32 mode) {
    return sys_create_file(path, flags as u32, 0, 0 as! *void, mode as u32, 128, 0 as! *void);
}

// close - close a file handle.
i64 close(i64 fd) {
    if (sys_close_handle(fd) == 0) { return -1; }
    return 0;
}

// seek - seek within a file. whence: 0 = BEGIN, 1 = CURRENT, 2 = END.
i64 seek(i64 fd, i64 offset, i32 whence) {
    i32 r = sys_set_file_pointer(fd, offset, (&g_fp) as! *void, whence as u32);
    if (r == 0) { return -1; }
    return g_fp.v;
}

// flush - flush file buffers to disk.
i64 flush(i64 fd) {
    if (sys_flush_file_buffers(fd) == 0) { return -1; }
    return 0;
}
