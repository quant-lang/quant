// std::format
//
// Number-to-string formatting, used by `as str` casts.
// Pure Quant implementation. Each result is copied into its own heap
// allocation so multiple formatted strings can coexist.

module "std::format";

load "std::heap";

// Scratch buffers: digits are written into them backwards and then
// compacted to the front of the buffer.
struct Buf32 {
    u64 f0;
    u64 f1;
    u64 f2;
    u64 f3;
};

struct Buf64 {
    u64 f0;
    u64 f1;
    u64 f2;
    u64 f3;
    u64 f4;
    u64 f5;
    u64 f6;
    u64 f7;
};

@init mut Buf32 g_buf32;
@init mut Buf64 g_buf64;

// Copy a NUL-terminated buffer into a fresh heap allocation and return it
// as a string. Falls back to the scratch buffer if allocation fails.
str to_heap(str src) {
    mut i64 n = 0;
    while (src[n] != 0) {
        n++;
    }
    str buf = std::heap::heap_malloc((n + 1) as u64) as! str;
    if (buf == (0 as! str)) {
        return src;
    }
    for (mut i64 i = 0; i <= n; i++) {
        buf[i] = src[i];
    }
    return buf;
}

// Write the decimal digits of `v` into `p` backwards, ending at index 30.
// Returns the index just before the first digit.
i32 digits_u64(u64 v, str p) {
    mut u64 val = v;
    mut i32 i = 30;
    if (val == 0) {
        p[i] = 48;
        i--;
    } else {
        while (val != 0) {
            u64 q = val / 10;
            u64 r = val - q * 10;
            p[i] = (48 + r) as char;
            val = q;
            i--;
        }
    }
    return i;
}

// Copy the digits [first+1..30] to the front of the buffer (offset by `neg`)
// and NUL-terminate.
void finish(str p, i32 first, i32 neg) {
    mut i32 src = first + 1;
    mut i32 dst = neg;
    while (src <= 30) {
        p[dst] = p[src];
        src++;
        dst++;
    }
    if (neg != 0) {
        p[0] = 45;
    }
    p[dst] = 0;
}

@export("qk_format_i64")
str format_i64(i64 v) {
    str p = (&g_buf32) as! str;
    mut i32 neg = 0;
    mut u64 val = 0;
    if (v < 0) {
        neg = 1;
        val = (0 - v) as u64;
    } else {
        val = v as u64;
    }
    i32 i = digits_u64(val, p);
    finish(p, i, neg);
    return to_heap(p);
}

@export("qk_format_u64")
str format_u64(u64 v) {
    str p = (&g_buf32) as! str;
    i32 i = digits_u64(v, p);
    finish(p, i, 0);
    return to_heap(p);
}

@export("qk_format_f64")
str format_f64(f64 v) {
    if (v != v) {
        return "nan";
    }
    if (v > 1.7976931348623157e308) {
        return "inf";
    }
    if (v < -1.7976931348623157e308) {
        return "-inf";
    }
    str p = (&g_buf64) as! str;
    mut i32 neg = 0;
    mut f64 x = v;
    if (v < 0.0) {
        neg = 1;
        x = 0.0 - v;
    }
    mut i32 e = 0;
    if (x >= 9.2233720368547758e18) {
        while (x >= 10.0) {
            x = x / 10.0;
            e++;
        }
    }
    i64 ipart = x as i64;
    i32 i = digits_u64(ipart as u64, p);
    mut i32 src = i + 1;
    mut i32 dst = neg;
    while (src <= 30) {
        p[dst] = p[src];
        src++;
        dst++;
    }
    if (neg != 0) {
        p[0] = 45;
    }
    mut f64 frac = x - (ipart as f64);
    mut i32 nd = 0;
    if (frac != 0.0) {
        p[dst] = 46;
        dst++;
        mut i32 done = 0;
        while ((nd < 6) && (done == 0)) {
            frac = frac * 10.0;
            i64 d = frac as i64;
            if ((d < 0) || (d > 9)) {
                done = 1;
            } else {
                p[dst] = (48 + d) as char;
                dst++;
                nd++;
                frac = frac - (d as f64);
                if (frac == 0.0) { done = 1; }
            }
        }
        while ((nd > 0) && (p[dst - 1] == 48)) {
            dst--;
            nd--;
        }
        if (nd == 0) {
            dst--;
        }
    }
    if (e != 0) {
        p[dst] = 101;
        dst++;
        i32 je = digits_u64(e as u64, p);
        mut i32 src2 = je + 1;
        while (src2 <= 30) {
            p[dst] = p[src2];
            src2++;
            dst++;
        }
    }
    p[dst] = 0;
    return to_heap(p);
}
