// std::format
//
// Number-to-string formatting, used by `as str` casts.
// Every call writes into its own heap allocation, so multiple formatted
// strings can coexist without a shared scratch buffer.

module "std::format";

load "std::heap";

/// Buffer helpers ///

u64 put_char(str p, u64 pos, char c) {
    p[pos] = c;
    return pos + 1;
}

// Write decimal digits straight into their final positions: the digit
// count is known up front, so no temporary buffer or second copy is needed.
u64 put_u64(str p, u64 pos, mut u64 v) {
    mut u64 n = 1;
    mut u64 t = v;
    while (t >= 10) {
        t /= 10;
        n++;
    }
    for (mut u64 i = n; i > 0; i--) {
        u64 q = v / 10;
        p[pos + i - 1] = (48 + (v - q * 10)) as char;
        v = q;
    }
    return pos + n;
}

// Up to six fractional digits, without trailing zeros or a bare dot.
u64 put_fraction(str p, mut u64 pos, mut f64 frac) {
    if (frac == 0.0) return pos;
    pos = put_char(p, pos, 46 as char);
    mut i32 nd = 0;
    for (; (nd < 6) && (frac != 0.0); nd++) {
        frac *= 10.0;
        i64 d = frac as i64;
        if ((d < 0) || (d > 9)) break;
        pos = put_char(p, pos, (48 + d) as char);
        frac -= d as f64;
    }
    while ((nd > 0) && (p[pos - 1] == 48)) {
        pos--;
        nd--;
    }
    if (nd == 0) pos--;
    return pos;
}

/// Integers ///

@export("qk_format_i64")
str format_i64(i64 v) {
    str p = std::heap::heap_malloc(32) as! str;
    if (p == nullptr) return "";

    mut u64 pos = 0;
    if (v < 0) {
        pos = put_char(p, pos, 45 as char);
        pos = put_u64(p, pos, (0 - v) as u64);
    } else {
        pos = put_u64(p, pos, v as u64);
    }
    p[pos] = 0;
    return p;
}

@export("qk_format_u64")
str format_u64(u64 v) {
    str p = std::heap::heap_malloc(32) as! str;
    if (p == nullptr) return "";

    u64 pos = put_u64(p, 0, v);
    p[pos] = 0;
    return p;
}

/// Floats ///

@export("qk_format_f64")
str format_f64(f64 v) {
    if (v != v) return "nan";
    if (v > 1.7976931348623157e308) return "inf";
    if (v < -1.7976931348623157e308) return "-inf";

    str p = std::heap::heap_malloc(32) as! str;
    if (p == nullptr) return "";

    mut u64 pos = 0;
    mut f64 x = v;
    if (x < 0.0) {
        pos = put_char(p, pos, 45 as char);
        x = 0.0 - x;
    }
    if (x == 0.0) {
        pos = put_char(p, pos, 48 as char);
        p[pos] = 0;
        return p;
    }

    // Normalize to a mantissa in [1, 10) and count decimal shifts. The
    // correction pass keeps the mantissa in range when a power of ten is
    // rounded just below 1 or just above 10 by repeated division.
    mut f64 m = x;
    mut i32 e = 0;
    if (m >= 10.0) {
        while (m >= 10.0) {
            m /= 10.0;
            e++;
        }
        if (m < 1.0) {
            m *= 10.0;
            e--;
        }
    } else if (m < 1.0) {
        while (m < 1.0) {
            m *= 10.0;
            e--;
        }
        if (m >= 10.0) {
            m /= 10.0;
            e++;
        }
    }

    // Outside [1e-4, 1e6) fixed notation loses the significant digits of
    // tiny values and drowns the fraction of huge ones.
    if ((e >= 6) || (e <= -5)) {
        i64 d = m as i64;
        pos = put_u64(p, pos, d as u64);
        pos = put_fraction(p, pos, m - (d as f64));
        pos = put_char(p, pos, 101 as char);
        if (e < 0) {
            pos = put_char(p, pos, 45 as char);
            pos = put_u64(p, pos, (0 - e) as u64);
        } else {
            pos = put_u64(p, pos, e as u64);
        }
        p[pos] = 0;
        return p;
    }

    i64 ipart = x as i64;
    pos = put_u64(p, pos, ipart as u64);
    pos = put_fraction(p, pos, x - (ipart as f64));
    p[pos] = 0;
    return p;
}
