load "std::io";
using std::io;

load "std::arena";
using std::arena;

load "front::lexer";
using front::lexer;

load "front::parser";
using front::parser;

load "front::token";
using front::token;

load "front::ast";
using front::ast;

load "front::ast_serialize";
using front::ast_serialize;

@entry i32 main() {
    
    str src = buf as! str;
    mut i64 file = std::io::open("test_output.txt", 0x40000000, 1);

    Lexer l = lexer_init(src);
    Parser p = parser_init(l, r);
    *ModuleBody body = parse(&p);
    if (body == nullptr)
        return 1;

    mut BufWriter w;
    w.buf = out_buf;
    w.pos = 0;
    w.cap = 16384;

    ser_module(&w, body);
    return 0;
}
